import { NextResponse } from "next/server";
import { randomUUID } from "node:crypto";
import { createClient } from "@supabase/supabase-js";

export const dynamic = "force-dynamic";
export const runtime = "nodejs";

type SupabaseProofClient = {
  from: (table: string) => any;
};

type ProofResult = {
  ok: boolean;
  mode: string;
  detail?: string;
  [key: string]: unknown;
};

export async function GET() {
  const database = await verifyDatabase();
  const ok = database.ok;

  return NextResponse.json(
    {
      ok,
      app: "{{appName}}",
      forged_at: "{{forgedAt}}",
      recipe: "{{recipeName}}@{{recipeVersion}}",
      database,
      timestamp: new Date().toISOString(),
    },
    { status: ok ? 200 : 503 },
  );
}

async function verifyDatabase() {
  const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
  const serviceRoleKey = process.env.SUPABASE_SERVICE_ROLE_KEY;

  const shouldCrud = process.env.HEALTH_DB_CRUD_PROOF === "1";
  const shouldSchema = process.env.HEALTH_DB_SCHEMA_PROOF === "1";
  const shouldSeed = process.env.HEALTH_DB_SEED_PROOF === "1";

  if (
    !url ||
    !serviceRoleKey ||
    url === "https://example.supabase.co" ||
    (!shouldCrud && !shouldSchema && !shouldSeed)
  ) {
    return {
      ok: true,
      mode: "not_configured",
      detail: "Supabase/Postgres proof skipped because staging credentials are not configured.",
    };
  }

  const supabase = createClient(url, serviceRoleKey, {
    auth: {
      autoRefreshToken: false,
      persistSession: false,
    },
  });

  const schema = shouldSchema ? await verifySchema(supabase) : null;
  const seed = shouldSeed ? await verifySeed(supabase) : null;
  const crud = shouldCrud ? await verifyCrud(supabase) : null;
  const checks = [schema, seed, crud].filter(Boolean) as ProofResult[];
  const ok = checks.every((check) => check.ok);

  if (crud) {
    return {
      ...crud,
      ok,
      schema,
      seed,
    };
  }

  return {
    ok,
    mode: "schema_seed_probe",
    schema,
    seed,
  };
}

async function verifySchema(supabase: SupabaseProofClient): Promise<ProofResult> {
  const expectedTables = (
    process.env.HEALTH_DB_EXPECTED_TABLES || "tenants,tenant_memberships,audit_events"
  )
    .split(",")
    .map((table) => table.trim())
    .filter(Boolean);
  const checked: string[] = [];
  for (const table of expectedTables) {
    const { error } = await supabase.from(table).select("*", { count: "exact", head: true });
    if (error) {
      return {
        ok: false,
        mode: "schema_drift_probe",
        expected_tables: expectedTables,
        checked_tables: checked,
        missing_or_inaccessible_table: table,
        detail: error.message,
      };
    }
    checked.push(table);
  }
  return {
    ok: true,
    mode: "schema_drift_probe",
    expected_tables: expectedTables,
    checked_tables: checked,
  };
}

async function verifySeed(supabase: SupabaseProofClient): Promise<ProofResult> {
  const slug = process.env.HEALTH_DB_SEED_SLUG || "health-seed-{{appName}}";
  const displayName = "Health Seed Proof";
  const upserted = await supabase
    .from("tenants")
    .upsert({ slug, display_name: displayName }, { onConflict: "slug" })
    .select("id,slug,display_name")
    .single();
  if (upserted.error || !upserted.data?.id) {
    return {
      ok: false,
      mode: "seed_data_probe",
      operation: "upsert",
      detail: upserted.error?.message ?? "missing seed row id",
    };
  }

  const read = await supabase
    .from("tenants")
    .select("id,slug,display_name")
    .eq("slug", slug)
    .single();
  if (read.error || read.data?.display_name !== displayName) {
    return {
      ok: false,
      mode: "seed_data_probe",
      operation: "read",
      detail: read.error?.message ?? "seed row did not round-trip",
    };
  }

  return {
    ok: true,
    mode: "seed_data_probe",
    table: "tenants",
    slug,
    operation: "upsert-read",
  };
}

async function verifyCrud(supabase: SupabaseProofClient) {
  const slug = `health-${randomUUID()}`;
  const inserted = await supabase
    .from("tenants")
    .insert({
      slug,
      display_name: "Health Proof",
    })
    .select("id")
    .single();
  if (inserted.error || !inserted.data?.id) {
    return fail("insert", inserted.error?.message ?? "missing inserted row id");
  }

  const id = inserted.data.id;
  const read = await supabase.from("tenants").select("id,display_name").eq("id", id).single();
  if (read.error) return fail("read", read.error.message);

  const updated = await supabase
    .from("tenants")
    .update({ display_name: "Health Proof Verified" })
    .eq("id", id)
    .select("display_name")
    .single();
  if (updated.error) return fail("update", updated.error.message);

  const deleted = await supabase.from("tenants").delete().eq("id", id);
  if (deleted.error) return fail("delete", deleted.error.message);

  return {
    ok: true,
    mode: "crud_probe",
    table: "tenants",
    operation: "insert-read-update-delete",
  };
}

function fail(operation: string, detail: string) {
  return {
    ok: false,
    mode: "crud_probe",
    operation,
    detail,
  };
}

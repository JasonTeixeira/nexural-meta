-- {{appName}} — RAG schema (additive to parent's 0001_init.sql).
-- pgvector + chunks + citations + safe-link logging.

-- ============================================================================
-- pgvector
-- ============================================================================

create extension if not exists vector;

-- ============================================================================
-- Documents
-- ============================================================================

create table public.documents (
  id uuid primary key default gen_random_uuid(),
  tenant_id uuid not null references public.tenants(id) on delete cascade,
  uploader_id uuid not null references auth.users(id),
  filename text not null,
  content_type text not null,
  size_bytes int8 not null,
  storage_path text not null,             -- supabase storage object key
  status text not null default 'queued' check (status in ('queued','indexing','ready','failed','deleted')),
  failed_reason text,
  uploaded_at timestamptz not null default now(),
  indexed_at timestamptz,
  deleted_at timestamptz
);

create index idx_documents_tenant_status on public.documents (tenant_id, status) where deleted_at is null;

alter table public.documents enable row level security;

create policy documents_tenant on public.documents for all
  using (
    exists (
      select 1 from public.tenant_memberships
      where tenant_id = documents.tenant_id and user_id = auth.uid()
    )
  );

-- ============================================================================
-- Chunks + embeddings
-- ============================================================================
-- Per recipe DECISIONS.md: 800 tokens with 100 token overlap, 3072-dim embeddings.

create table public.chunks (
  id uuid primary key default gen_random_uuid(),
  document_id uuid not null references public.documents(id) on delete cascade,
  tenant_id uuid not null references public.tenants(id) on delete cascade,
  chunk_index int4 not null,
  content text not null,
  token_count int4 not null,
  embedding vector(3072),
  created_at timestamptz not null default now(),
  unique (document_id, chunk_index)
);

-- HNSW index for fast nearest-neighbor; ~1M chunks practical limit on pgvector
create index idx_chunks_embedding on public.chunks
  using hnsw (embedding vector_cosine_ops)
  with (m = 16, ef_construction = 64);

create index idx_chunks_tenant on public.chunks (tenant_id);

-- Full-text search for hybrid retrieval (BM25 equivalent)
alter table public.chunks add column content_tsv tsvector
  generated always as (to_tsvector('english', content)) stored;
create index idx_chunks_content_tsv on public.chunks using gin (content_tsv);

alter table public.chunks enable row level security;

create policy chunks_tenant on public.chunks for all
  using (
    exists (
      select 1 from public.tenant_memberships
      where tenant_id = chunks.tenant_id and user_id = auth.uid()
    )
  );

-- ============================================================================
-- Conversations + messages
-- ============================================================================

create table public.conversations (
  id uuid primary key default gen_random_uuid(),
  tenant_id uuid not null references public.tenants(id) on delete cascade,
  user_id uuid not null references auth.users(id),
  title text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create index idx_conversations_user on public.conversations (user_id, updated_at desc);

create type public.message_role as enum ('user','assistant','system');

create table public.messages (
  id uuid primary key default gen_random_uuid(),
  conversation_id uuid not null references public.conversations(id) on delete cascade,
  tenant_id uuid not null references public.tenants(id) on delete cascade,
  role public.message_role not null,
  content text not null,
  citations jsonb,                  -- array of {warehouse, id, chunk_id}
  hallucinated_citations jsonb,     -- stripped citations per ADR-0008 §1
  cost_usd numeric(10, 6),          -- per-message LLM cost from llmClient
  model_id text,                    -- resolved model ID (e.g. claude-opus-4-7)
  latency_ms int4,
  created_at timestamptz not null default now()
);

create index idx_messages_conversation on public.messages (conversation_id, created_at);

alter table public.conversations enable row level security;
alter table public.messages enable row level security;

create policy conversations_tenant on public.conversations for all
  using (
    exists (
      select 1 from public.tenant_memberships
      where tenant_id = conversations.tenant_id and user_id = auth.uid()
    )
  );

create policy messages_tenant on public.messages for all
  using (
    exists (
      select 1 from public.tenant_memberships
      where tenant_id = messages.tenant_id and user_id = auth.uid()
    )
  );

-- ============================================================================
-- Safe-link log (per THREAT_MODEL.md §2 — defeats output URL exfiltration)
-- ============================================================================

create table public.safe_link_log (
  id uuid primary key default gen_random_uuid(),
  tenant_id uuid not null references public.tenants(id) on delete cascade,
  user_id uuid references auth.users(id),
  message_id uuid not null references public.messages(id) on delete cascade,
  original_url text not null,
  rewritten_url text not null,
  clicked_at timestamptz,
  created_at timestamptz not null default now()
);

create index idx_safe_link_message on public.safe_link_log (message_id);

alter table public.safe_link_log enable row level security;

create policy safe_link_tenant on public.safe_link_log for select
  using (
    exists (
      select 1 from public.tenant_memberships
      where tenant_id = safe_link_log.tenant_id and user_id = auth.uid()
    )
  );

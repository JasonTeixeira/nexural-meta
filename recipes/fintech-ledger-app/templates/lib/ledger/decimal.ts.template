/**
 * Precision-safe monetary math.
 *
 * Money is stored as bigint at {{decimalPrecision}}-decimal precision
 * (1.00 USD = 10000n at precision 4). NEVER use JS number for money —
 * 0.1 + 0.2 = 0.30000000000000004 is a regulatory event.
 *
 * Provenance: scaled-integer pattern is industry standard for finance;
 * here implemented in 60 lines without a dep (Big.js / dinero.js would
 * work, but the surface area we need is tiny + auditable).
 */

const SCALE = {{decimalPrecision}};
const SCALE_BIGINT = 10n ** BigInt(SCALE);

export type MicroAmount = bigint;

/** Convert a decimal string ("12.34") to a micro-amount bigint. */
export function parseAmount(input: string): MicroAmount {
  const trimmed = input.trim();
  const match = trimmed.match(/^(-?)(\d+)(?:\.(\d+))?$/);
  if (!match) throw new Error(`invalid decimal: ${input}`);
  const sign = match[1] === "-" ? -1n : 1n;
  const intPart = BigInt(match[2] ?? "0");
  const frac = (match[3] ?? "").padEnd(SCALE, "0").slice(0, SCALE);
  const fracPart = BigInt(frac.length > 0 ? frac : "0");
  return sign * (intPart * SCALE_BIGINT + fracPart);
}

/** Format a micro-amount back to a decimal string. */
export function formatAmount(micro: MicroAmount): string {
  const negative = micro < 0n;
  const abs = negative ? -micro : micro;
  const intPart = abs / SCALE_BIGINT;
  const fracPart = abs % SCALE_BIGINT;
  const fracStr = fracPart.toString().padStart(SCALE, "0");
  return `${negative ? "-" : ""}${intPart.toString()}.${fracStr}`;
}

export function add(a: MicroAmount, b: MicroAmount): MicroAmount {
  return a + b;
}
export function sub(a: MicroAmount, b: MicroAmount): MicroAmount {
  return a - b;
}

/** Multiply by an integer scalar. NEVER multiply by a float — instead, scale + divide. */
export function mulInt(a: MicroAmount, n: bigint): MicroAmount {
  return a * n;
}

/**
 * Multiply by a scaled bps integer (e.g. 250 = 2.50% = 250 / 10000).
 * Throws if the result would lose precision.
 */
export function applyBps(a: MicroAmount, bps: bigint): MicroAmount {
  return (a * bps) / 10000n;
}

/** Verify a set of entries sums to zero (double-entry invariant). */
export function isBalanced(entries: ReadonlyArray<MicroAmount>): boolean {
  return entries.reduce((acc, x) => acc + x, 0n) === 0n;
}

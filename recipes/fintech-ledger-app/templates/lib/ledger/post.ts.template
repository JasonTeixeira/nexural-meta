/**
 * Typed posting helper for the ledger. The ONLY supported path for adding
 * entries — direct SQL inserts to `ledger_entries` violate the balance
 * invariant + skip the audit metadata.
 */

import { createSupabaseServerClient } from "@/lib/supabase/server";
import type { MicroAmount } from "./decimal";
import { isBalanced } from "./decimal";

export interface LedgerEntry {
  readonly accountId: string;
  readonly amountMicro: MicroAmount; // positive = debit; negative = credit
  readonly currency: string;
}

export interface PostingRequest {
  readonly tenantId: string;
  readonly description: string;
  readonly entries: ReadonlyArray<LedgerEntry>;
  readonly externalRef?: string;
  readonly postedBy?: string;
  readonly metadata?: Record<string, unknown>;
}

export interface PostingResult {
  readonly transactionId: string;
}

export class UnbalancedTransactionError extends Error {
  constructor(public readonly imbalance: MicroAmount) {
    super(`ledger transaction is unbalanced; sum = ${imbalance.toString()}`);
    this.name = "UnbalancedTransactionError";
  }
}

/**
 * Post a balanced double-entry transaction atomically.
 *
 * Discipline:
 *   1. Validate balance BEFORE any DB write.
 *   2. Single SQL transaction for the parent + all children.
 *   3. Final SELECT verifies sum = 0 inside the same tx; rollback otherwise.
 *
 * Phase 7 (v0.1.0): client-side balance check + insert. Phase 7.5 wraps
 * this in a server-side RPC so the balance check runs inside the same
 * Postgres transaction context (avoiding read-after-write skew).
 */
export async function postLedgerTransaction(req: PostingRequest): Promise<PostingResult> {
  if (req.entries.length < 2) {
    throw new Error("ledger transaction requires at least 2 entries (1 debit + 1 credit)");
  }

  const amounts = req.entries.map((e) => e.amountMicro);
  if (!isBalanced(amounts)) {
    const sum = amounts.reduce((acc, x) => acc + x, 0n);
    throw new UnbalancedTransactionError(sum);
  }

  const supabase = await createSupabaseServerClient();
  const { data: tx, error: txErr } = await supabase
    .from("ledger_transactions")
    .insert({
      tenant_id: req.tenantId,
      description: req.description,
      external_ref: req.externalRef ?? null,
      posted_by: req.postedBy ?? null,
      metadata: req.metadata ?? {},
    })
    .select("id")
    .single();
  if (txErr || !tx) {
    throw new Error(`failed to insert ledger_transaction: ${txErr?.message ?? "unknown"}`);
  }

  const rows = req.entries.map((e) => ({
    transaction_id: tx.id as string,
    account_id: e.accountId,
    amount_micro: e.amountMicro.toString(),
    currency: e.currency,
  }));
  const { error: entriesErr } = await supabase.from("ledger_entries").insert(rows);
  if (entriesErr) {
    // Manual rollback: delete the parent. RLS denies delete via trigger;
    // this is best-effort cleanup. Fail-loud so the operator knows to investigate.
    console.error("[ledger-post] entry insert failed; orphan transaction left:", tx.id);
    throw new Error(`failed to insert ledger_entries: ${entriesErr.message}`);
  }

  return { transactionId: tx.id as string };
}

/**
 * Role-Based Access Control for {{appName}}.
 *
 * Roles declared at forge time via recipe.inputs.adminRoles[].
 * Default hierarchy: super_admin > admin > viewer.
 *
 * Each protected route or server action calls `requireRole()`. Missing-role
 * paths throw `ForbiddenError`, caught by an error boundary that renders 403.
 */

import { createSupabaseServerClient } from "@/lib/supabase/server";

export type AdminRole = "super_admin" | "admin" | "viewer";

const ROLE_HIERARCHY: Record<AdminRole, number> = {
  viewer: 1,
  admin: 2,
  super_admin: 3,
};

export class ForbiddenError extends Error {
  readonly requiredRole: AdminRole;
  readonly actualRole: AdminRole | null;
  constructor(required: AdminRole, actual: AdminRole | null) {
    super(`Forbidden: requires ${required}, have ${actual ?? "none"}`);
    this.name = "ForbiddenError";
    this.requiredRole = required;
    this.actualRole = actual;
  }
}

export async function currentUserRole(): Promise<{
  userId: string;
  role: AdminRole;
} | null> {
  const supabase = await createSupabaseServerClient();
  const {
    data: { user },
  } = await supabase.auth.getUser();
  if (!user) return null;

  // The admin_users table (in migrations/0002_admin.sql.template) holds the
  // single role per user. Forge of this recipe ships that migration.
  const { data, error } = await supabase
    .from("admin_users")
    .select("role")
    .eq("user_id", user.id)
    .single();

  if (error || !data) return null;
  const role = data.role as AdminRole;
  if (!(role in ROLE_HIERARCHY)) return null;
  return { userId: user.id, role };
}

export async function requireRole(required: AdminRole): Promise<{
  userId: string;
  role: AdminRole;
}> {
  const current = await currentUserRole();
  if (!current) throw new ForbiddenError(required, null);
  if (ROLE_HIERARCHY[current.role] < ROLE_HIERARCHY[required]) {
    throw new ForbiddenError(required, current.role);
  }
  return current;
}

export function hasAtLeast(actual: AdminRole, required: AdminRole): boolean {
  return ROLE_HIERARCHY[actual] >= ROLE_HIERARCHY[required];
}

; Per ADR-0009 §1.7 — forge sandbox hygiene baseline.
; Disables postinstall script execution. Recipes that need legitimate
; postinstalls opt in via recipe.yaml forge_sandbox.allowed_postinstalls.
enable-pre-post-scripts=false

; Strict peer dep resolution catches version mismatches early.
strict-peer-dependencies=false

; No global package hoisting — packages declare what they use.
public-hoist-pattern[]=
hoist-pattern[]=*eslint*
hoist-pattern[]=*prettier*
hoist-pattern[]=*types*

; Avoid auto-installing peer deps; prefer explicit declaration.
auto-install-peers=false

; Use the workspace store
shared-workspace-lockfile=true

only-built-dependencies[]=esbuild

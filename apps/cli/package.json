{
  "name": "@nexural/cli",
  "version": "0.1.0",
  "description": "The `nx` CLI — single human-facing command for the Nexural Federation. Per ARCHITECTURE.md §4.1.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nx": "./dist/bin/nx.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@nexural/factory": "workspace:^",
    "@nexural/forge-emit": "workspace:^",
    "@nexural/model-router": "workspace:^",
    "@nexural/schema": "workspace:^",
    "@nexural/sdk": "workspace:^",
    "@nexural/warehouse-base": "workspace:^",
    "better-sqlite3": "^11.7.2",
    "commander": "^12.1.0",
    "ink": "^5.1.1",
    "react": "^18.3.1",
    "smol-toml": "^1.3.1",
    "yaml": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JasonTeixeira/nexural-meta.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/JasonTeixeira/nexural-meta/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/JasonTeixeira/nexural-meta/issues"
  }
}

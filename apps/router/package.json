{
  "name": "@nexural/router",
  "version": "1.0.0",
  "description": "MCP router — fans out queries to federation warehouse MCP servers + external MCPs, applies prompt-injection wrapping + citation validation + token-budget trimming + tier confinement, synthesizes via @nexural/model-router-resolved LLM provider. Per ARCHITECTURE §4.2 + ADRs 0005, 0007, 0008, 0009, 0010.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "nexural-router": "./dist/bin/router.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "start": "node dist/bin/router.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@nexural/mcp-base": "workspace:^",
    "@nexural/model-router": "workspace:^",
    "@nexural/schema": "workspace:^",
    "@nexural/sdk": "workspace:^",
    "openai": "^4.77.0",
    "smol-toml": "^1.3.1",
    "zod": "^3.24.1"
  }
}

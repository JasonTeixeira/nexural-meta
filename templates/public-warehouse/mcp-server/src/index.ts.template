/**
 * MCP server for {{TOPIC}}-warehouse.
 *
 * Extends @nexural/mcp-base. Exposes search + get_pattern tools.
 * Federated by nexural-meta/apps/router.
 */

import { buildHandler, wrapInEnvelope } from "@nexural/mcp-base";
import { existsSync, readFileSync, readdirSync } from "node:fs";
import { join, resolve } from "node:path";

const WAREHOUSE_ROOT = resolve(import.meta.dirname, "../..");
const WAREHOUSE_NAME = "{{TOPIC}}";

// Read meta.yaml for decay config
const metaContent = readFileSync(join(WAREHOUSE_ROOT, "meta.yaml"), "utf8");
const decayDays = parseInt(metaContent.match(/decay_rate_days:\s*(\d+)/)?.[1] ?? "90", 10);
const lastReviewed = metaContent.match(/last_reviewed:\s*(\S+)/)?.[1] ?? "2026-01-01";

// In a full impl, this dispatches by tool name. For Phase 5 we wire one tool.
const searchHandler = buildHandler(
  WAREHOUSE_NAME,
  decayDays,
  lastReviewed,
  async (request) => {
    const query = (request.args.query as string) ?? "";
    const results = searchContent(query);
    return {
      data: {
        results: results.map((r) => ({
          id: r.id,
          title: r.title,
          excerpt: r.excerpt,
          content: wrapInEnvelope(r.body, { warehouse: WAREHOUSE_NAME, id: r.id }),
        })),
      },
      citations: results.map((r) => ({ warehouse: WAREHOUSE_NAME, id: r.id })),
    };
  },
  (_event) => {
    // emit telemetry — in Phase 5+, write to ~/.nexural/telemetry.db
  },
);

function searchContent(query: string): Array<{
  id: string;
  title: string;
  excerpt: string;
  body: string;
}> {
  const contentDir = join(WAREHOUSE_ROOT, "content");
  if (!existsSync(contentDir)) return [];

  const q = query.toLowerCase();
  const results: Array<{ id: string; title: string; excerpt: string; body: string }> = [];

  for (const entry of readdirSync(contentDir)) {
    const bodyPath = join(contentDir, entry, "body.md");
    const fmPath = join(contentDir, entry, "frontmatter.yaml");
    if (!existsSync(bodyPath) || !existsSync(fmPath)) continue;
    const body = readFileSync(bodyPath, "utf8");
    const title = readFileSync(fmPath, "utf8").match(/^title:\s*(.+)$/m)?.[1] ?? entry;
    if (q === "" || body.toLowerCase().includes(q) || title.toLowerCase().includes(q)) {
      results.push({
        id: entry,
        title: title.replace(/^["']|["']$/g, ""),
        excerpt: body.slice(0, 200),
        body,
      });
    }
  }
  return results;
}

// Wire stdio MCP transport here when @modelcontextprotocol/sdk imports are
// added. Phase 5 ships the handler skeleton; full transport in Phase 5.5 polish.
export { searchHandler };

#!/usr/bin/env node
/**
 * build-index.mjs — generates index.json from content/ frontmatter.
 *
 * Generated artifact per SCHEMA_CHARTER §4.3. Pre-commit hook compares
 * the committed file's hash against fresh output; mismatch fails commit.
 */

import { WarehouseIndex } from "@nexural/schema";
import { existsSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const metaContent = readFileSync("meta.yaml", "utf8");
const warehouseName = metaContent.match(/^name:\s*(\S+)/m)?.[1] ?? "unknown";

const entries = [];
const contentDir = "content";
if (existsSync(contentDir)) {
  for (const entryName of readdirSync(contentDir)) {
    const fmPath = join(contentDir, entryName, "frontmatter.yaml");
    if (!existsSync(fmPath)) continue;
    const fm = parseSimpleYaml(readFileSync(fmPath, "utf8"));
    entries.push({
      id: fm.id ?? entryName,
      path: `content/${entryName}/body.md`,
      title: fm.title ?? entryName,
      tags: fm.tags ?? [],
      updated: fm.updated ?? new Date().toISOString().slice(0, 10),
      last_reviewed: fm.last_reviewed ?? new Date().toISOString().slice(0, 10),
      source_type: fm.source_type ?? "reference",
    });
  }
}

const index = {
  schema_version: 1,
  warehouse: warehouseName,
  generated_at: new Date().toISOString(),
  generator_version: "0.0.0",
  count: entries.length,
  entries,
  health: {
    decayed_entries: 0,
    draft_entries: 0,
  },
};

const result = WarehouseIndex.safeParse(index);
if (!result.success) {
  console.error("❌ Generated index.json fails schema:");
  console.error(result.error.format());
  process.exit(1);
}

writeFileSync("index.json", JSON.stringify(index, null, 2) + "\n", "utf8");
console.log(`✓ index.json (${entries.length} entries)`);

function parseSimpleYaml(content) {
  const obj = {};
  for (const line of content.split("\n")) {
    const m = line.match(/^(\w+):\s*(.+)$/);
    if (m) {
      const [, key, rawValue] = m;
      const v = rawValue.replace(/^["']|["']$/g, "");
      obj[key] = v;
    }
  }
  return obj;
}

{
  "name": "@nexural/voice-engine-client-react",
  "version": "0.1.0",
  "private": true,
  "description": "React + Next.js client kit for Nexural voice agents. One <VoiceProvider> + useVoice() and your app talks to any persona.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@livekit/components-react": ">=2.6.0",
    "livekit-client": ">=2.6.0",
    "livekit-server-sdk": ">=2.8.0"
  },
  "devDependencies": {
    "@livekit/components-react": "^2.6.0",
    "@types/react": "^18.3.0",
    "livekit-client": "^2.6.0",
    "livekit-server-sdk": "^2.8.0",
    "react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}

{
  "name": "@nexural/warehouse-base",
  "version": "0.1.0",
  "description": "Shared kit for warehouse content loading. Reads a warehouse's manifest.yaml + materializes documents and templates for nx forge / nx ask. Per ADR-0011 §2.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nexural/forge-emit": "workspace:^",
    "@nexural/schema": "workspace:^",
    "yaml": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JasonTeixeira/nexural-meta.git",
    "directory": "packages/warehouse-base"
  },
  "homepage": "https://github.com/JasonTeixeira/nexural-meta/tree/main/packages/warehouse-base#readme",
  "bugs": {
    "url": "https://github.com/JasonTeixeira/nexural-meta/issues"
  }
}

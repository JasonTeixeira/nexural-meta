{
  "name": "@nexural/warehouse-server",
  "version": "1.0.0",
  "description": "Generic MCP stdio server for any Nexural warehouse. Reads a warehouse root from args + exposes documents and templates as MCP tools. Phase 11.1 per ADR-0012 §5 (federation MCP layer).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nexural-warehouse-server": "./dist/bin/nexural-warehouse-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@nexural/mcp-base": "workspace:^",
    "@nexural/warehouse-base": "workspace:^",
    "yaml": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JasonTeixeira/nexural-meta.git",
    "directory": "packages/warehouse-server"
  },
  "homepage": "https://github.com/JasonTeixeira/nexural-meta/tree/main/packages/warehouse-server#readme",
  "bugs": {
    "url": "https://github.com/JasonTeixeira/nexural-meta/issues"
  }
}

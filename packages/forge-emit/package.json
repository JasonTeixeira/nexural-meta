{
  "name": "@nexural/forge-emit",
  "version": "1.0.0",
  "description": "Template render + filesystem emit engine for nx forge. Renders Handlebars-style {{vars}} + conditional blocks against validated recipe inputs and warehouse-supplied template files. Per ADR-0002, ADR-0011.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nexural/schema": "workspace:^",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "fast-check": "^3.23.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JasonTeixeira/nexural-meta.git",
    "directory": "packages/forge-emit"
  },
  "homepage": "https://github.com/JasonTeixeira/nexural-meta/tree/main/packages/forge-emit#readme",
  "bugs": {
    "url": "https://github.com/JasonTeixeira/nexural-meta/issues"
  }
}

# ── LiveKit (transport / WebRTC / SIP) ────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── LLM (the brain) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── STT ───────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ── TTS ───────────────────────────────────────────────────────────────
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# ── Memory (optional, mem0) ───────────────────────────────────────────
MEM0_API_KEY=

# ── Engine config ─────────────────────────────────────────────────────
# Path to the persona YAML this worker should run.
# Swap this per app — engine code never changes.
VOICE_PERSONA=personas/voice_coach.yaml

# Logging
LOG_LEVEL=INFO
